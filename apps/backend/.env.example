# Choose "demo" for hard-coded read-only data or "database" for MySQL.
APP_MODE=database

PORT=4000

# These local-development values match compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=osrs_app
DB_USER=osrs_user
DB_PASS=osrs_password

# Replace this with a long random value before deploying anywhere public.
JWT_SECRET=replace-with-a-long-random-local-secret
