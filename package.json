{
  "name": "OSRS App",
  "private": true,
  "version": "1.0.0",
  "description": "This Old School Runescape App is designed to show full-stack development and CI/CD pipeline. ",
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:demo": "node scripts/run-mode.mjs demo",
    "dev:db": "node scripts/run-mode.mjs database",
    "predev": "pnpm --filter @osrs-app/shared run build",
    "build": "pnpm --recursive run build",
    "check": "pnpm build && pnpm --filter frontend lint",
    "preview": "pnpm --filter frontend preview --open",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "Tanzeel Saeed",
  "packageManager": "pnpm@11.19.0"
}
